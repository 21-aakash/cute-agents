# ==========================================
# CareerOps AI Configuration
# ==========================================

# LLM Provider: gemini | openai | ollama
LLM_PROVIDER=gemini

# --- Google Gemini Settings (Recommended: High context, fast tool calls) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI / Custom OpenAI-Compatible Gateway Settings ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Local Ollama Settings ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Embedding Settings: local | openai ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Database & Vector Storage ---
DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research_agent
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_DOCUMENTS=documents
QDRANT_COLLECTION_MEMORY=memory
QDRANT_COLLECTION_VAULT=candidate_vault

# --- Observability (Phase 5) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=careerops-ai
